diff --git b/tailscale.com/wgengine/netstack/netstack_tcpbuf_wasip1.go b/tailscale.com/wgengine/netstack/netstack_tcpbuf_wasip1.go
new file mode 100644
index 0000000..9425bf8
--- /dev/null
+++ b/tailscale.com/wgengine/netstack/netstack_tcpbuf_wasip1.go
@@ -0,0 +1,32 @@
+// Copyright (c) Tailscale Inc & contributors
+// SPDX-License-Identifier: BSD-3-Clause
+
+//go:build wasip1
+
+package netstack
+
+import (
+	"gvisor.dev/gvisor/pkg/tcpip/transport/tcp"
+)
+
+// WebAssembly runs every goroutine on one thread without preemption. A TCP
+// sender therefore queues its whole burst for WireGuard before the goroutine
+// that drains the queue gets to run, and whatever does not fit is dropped,
+// retransmissions included. The connection then recovers one retransmission
+// timeout at a time. So bound what a connection can have in flight (the send
+// buffer, and the window the peer is offered) and give the queue room for
+// several connections' worth of it.
+const (
+	tcpRXBufMinSize = tcp.MinBufferSize
+	tcpRXBufDefSize = tcp.DefaultSendBufferSize
+	tcpRXBufMaxSize = 1 << 20 // 1MiB
+
+	tcpTXBufMinSize = tcp.MinBufferSize
+	tcpTXBufDefSize = tcp.DefaultReceiveBufferSize
+	tcpTXBufMaxSize = 1 << 20 // 1MiB
+
+	// linkEndpointQueueSize is the capacity, in packets, of each queue
+	// between netstack and its consumers (WireGuard, the host, loopback).
+	// A full 1MiB send buffer is under 900 packets.
+	linkEndpointQueueSize = 4096
+)
