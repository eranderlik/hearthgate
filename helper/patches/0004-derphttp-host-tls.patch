+// HostTLS, if non-nil, performs the TLS client handshake for DERP
+// connections in place of crypto/tls, returning the decrypted stream. It is
+// for programs, such as GOOS=wasip1 builds embedded in another runtime, whose
+// host can do TLS far faster than they can. The host must verify the server's
+// certificate chain against public roots and its name against serverName.
+//
+// It is used only where standard verification applies: not with a custom
+// TLSConfig, nor for nodes with a pinned CertName or InsecureForTests.
+var HostTLS func(ctx context.Context, nc net.Conn, serverName string) (net.Conn, error)
+
+func (c *Client) useHostTLS(node *tailcfg.DERPNode) bool {
+	return HostTLS != nil && c.TLSConfig == nil &&
+		(node == nil || (!node.InsecureForTests && node.CertName == ""))
+}
